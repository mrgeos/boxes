{
  "name": "box-studio-3d",
  "private": true,
  "type": "module",
  "description": "Редактор 3D-мокапов упаковки",
  "scripts": {
    "build": "node build.mjs",
    "check": "eslint src/app && node test/check-modules.mjs",
    "test": "npm run check && node build.mjs && node test/run.mjs",
    "prepush": "npm run check && node build.mjs --check && node test/run.mjs",
    "snapshots": "node test/snapshots.mjs"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "esbuild": "0.24.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "playwright": "1.56.1",
    "three": "0.169.0"
  }
}
